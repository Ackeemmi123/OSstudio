# Staging values for the staging scripts (npm run staging:check, npm run staging:smoke).
# Copy to .env.staging (ignored by git) or set them as environment variables.
# Never commit real values, and never use a production project here.
#
#   set -a; . ./.env.staging; set +a
#   npm run staging:check
#   STAGING_SMOKE=1 npm run staging:smoke

# Supabase → Project settings → API (or API Keys).
STAGING_SUPABASE_URL=
# The anon key (legacy) or the publishable key (sb_publishable_…).
STAGING_SUPABASE_ANON_KEY=
# The service_role key (legacy) or a secret key (sb_secret_…). Server only.
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Optional. Supabase → Connect → connection string (session pooler). Used only to
# read migration history and grants, and for `supabase db push`.
STAGING_DATABASE_URL=

# Optional. Checks the key and model; the smoke test uses the deployed app's key.
STAGING_ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
STAGING_AGENT_MODEL=

# Optional. The deployed staging app, e.g. https://studio-os-staging.vercel.app.
# Without it the smoke test checks Supabase only and skips the intake agent.
STAGING_APP_URL=

# Smoke test people, when the service role key is not set: three different
# existing accounts in the staging project. They need no Studio OS role.
STAGING_SMOKE_OWNER_EMAIL=
STAGING_SMOKE_VIEWER_EMAIL=
STAGING_SMOKE_OUTSIDER_EMAIL=
# One password for all three, or one per account (each falls back to the shared one).
STAGING_SMOKE_PASSWORD=
STAGING_SMOKE_OWNER_PASSWORD=
STAGING_SMOKE_VIEWER_PASSWORD=
STAGING_SMOKE_OUTSIDER_PASSWORD=

# Browser journey (npm run staging:e2e). STAGING_E2E=1 confirms it may add test
# data. The account defaults to the smoke test owner.
STAGING_E2E=
STAGING_E2E_EMAIL=
STAGING_E2E_PASSWORD=

# Website inquiry check (npm run staging:inquiry). STAGING_INQUIRY=1 confirms it
# may store one test inquiry. Uses STAGING_APP_URL. Keep the secret in your
# shell or password manager only.
STAGING_INQUIRY=
STAGING_INQUIRY_KEY_ID=
STAGING_INQUIRY_SECRET=
# Optional: Vercel "Protection Bypass for Automation" value.
STAGING_PROTECTION_BYPASS=
