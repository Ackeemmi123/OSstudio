# Copy to .env.local and fill in. Never commit real values.
# With none of these set, the app runs as the local demo (data in this browser only).

# "supabase" or "local". Optional: Supabase is used when its URL and key are set.
NEXT_PUBLIC_STUDIO_DATA_MODE=

# Browser-safe Supabase settings (Project settings → API). Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Records agent runs and proposals. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Client Intake & Research agent (server only). Without a key, "Analyze client information" is disabled.
ANTHROPIC_API_KEY=
# "anthropic" (default when ANTHROPIC_API_KEY is set) or "fixture" (tests only, no AI).
STUDIO_AGENT_PROVIDER=
# Defaults to claude-opus-5-5.
STUDIO_AGENT_MODEL=
# Per-run limit in milliseconds, 10000–110000. Defaults to 90000.
STUDIO_AGENT_TIMEOUT_MS=
# Must be 1 to allow the fixture provider. Leave empty in every real environment.
STUDIO_ALLOW_TEST_PROVIDER=
