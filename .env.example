# Copy to .env.local and fill in. Never commit real values.
# With none of these set, `npm run dev` runs the local demo (data in this browser only).
# A production build with none of these set shows a configuration error instead.

# "supabase" or "local". Optional: Supabase is used when its URL and key are set.
# "local" builds the demo on purpose; it cannot be combined with the Supabase settings.
NEXT_PUBLIC_STUDIO_DATA_MODE=

# Browser-safe Supabase settings (Project settings → API). Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Records agent runs and proposals. The service_role key or a secret
# key (sb_secret_…), never the anon key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Client Intake & Research agent (server only). Without a key, "Analyze client information" is disabled.
# The key is only ever sent to https://api.anthropic.com (ANTHROPIC_BASE_URL is ignored).
ANTHROPIC_API_KEY=
# "anthropic" (default when ANTHROPIC_API_KEY is set) or "fixture" (tests only, no AI).
STUDIO_AGENT_PROVIDER=
# Defaults to claude-opus-5-5.
STUDIO_AGENT_MODEL=
# Per-run limit in milliseconds, 10000–110000. Defaults to 90000.
STUDIO_AGENT_TIMEOUT_MS=
# Must be 1 to allow the fixture provider, which also only runs against a local
# Supabase stack. Leave empty in every real environment.
STUDIO_ALLOW_TEST_PROVIDER=
