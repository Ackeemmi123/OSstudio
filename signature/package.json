{
  "name": "@axivo/signature",
  "version": "0.1.0",
  "private": true,
  "description": "Axivo Signature: the motion, scroll, page-transition and WebGL engine for award-level client sites, with accessibility and weight budgets built in.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/layer-fixture.mjs",
    "build:layer": "node scripts/build-layer.mjs",
    "enhance": "node scripts/enhance.mjs",
    "layer-proof": "node scripts/layer-proof.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "budget": "node scripts/budget.mjs",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "review": "node scripts/review.mjs",
    "film": "node scripts/render-dom-film.mjs",
    "film-review": "node scripts/film-review.mjs",
    "check": "npm run build && npm run budget && npm run test && npm run lighthouse"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.28"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "mediabunny": "1.66.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.4.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
