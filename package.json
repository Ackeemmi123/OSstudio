{
  "name": "studio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/with-local-supabase.mjs vitest run -c vitest.db.config.mts",
    "test:e2e": "playwright test",
    "staging:check": "node scripts/staging-check.mjs",
    "staging:smoke": "vitest run -c vitest.staging.config.mts",
    "staging:inquiry": "node scripts/staging-inquiry.mjs",
    "staging:e2e": "playwright test -c playwright.staging.config.ts",
    "storage:purge": "node scripts/storage-purge.mjs",
    "db:start": "sh scripts/supabase-start.sh",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "eval:intake": "vitest run -c vitest.eval.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
